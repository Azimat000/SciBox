{
  "endpoint": "GET /api/chats/{id}/messages",
  "about": "Лента переписки от старых к новым. Без параметров — последние limit сообщений; before=seq — более старые, after=seq — более новые (после переподключения). has_more — есть ли ещё в сторону листания. Текст системной строки пуст: сайт собирает его из event. У удалённого сообщения текст пуст и deleted=true. editable_until — до какого момента своё сообщение можно исправить или удалить (у чужих и системных null). client_id видит только автор.",
  "query": {
    "before": "seq, листать к старым",
    "after": "seq, листать к новым",
    "limit": "1–100, по умолчанию 50"
  },
  "enums": {
    "items[].kind": "message_kind",
    "items[].author.side": "author_side",
    "items[].event.type": "event_type",
    "items[].event.data.invitation.kind": "invitation_kind",
    "items[].event.data.invitation.status": "invitation_status",
    "items[].event.data.invitation.place_kind": "place_kind",
    "items[].event.data.kind": "invitation_kind",
    "items[].event.data.answer": "invitation_answer|offer_answer",
    "items[].event.data.decision": "decision",
    "items[].event.data.status": "status_value"
  },
  "variants": {
    "items[].event": "type"
  },
  "errors": [
    "unauthorized",
    "not_found",
    "bad_request"
  ],
