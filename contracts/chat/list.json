{
  "endpoint": "GET /api/chats",
  "about": "Список переписок одной стороны, новые сверху (по updated_at), листание по ключу. Архив личный; новое сообщение возвращает переписку из архива. counts считаются по стороне без учёта поиска и отбора: unread — переписки с непрочитанным вне архива, archive — переписки в архиве.",
  "query": {
    "side": "scientist | org, обязательно",
    "box": "all (по умолчанию, без архива) | unread | archive",
    "q": "поиск по названию вакансии и имени собеседника (имя анонимного не ищется), до 100 знаков",
    "vacancy": "номер вакансии, только для side=org",
    "cursor": "next_cursor прошлой страницы",
    "limit": "1–50, по умолчанию 30"
  },
  "enums": {
    "items[].side": "side",
    "items[].counterpart.kind": "counterpart_kind",
    "items[].status.source": "status_source",
    "items[].status.value": "status_value",
    "items[].last_message.kind": "message_kind",
    "items[].last_message.author.side": "author_side",
    "items[].last_message.event_type": "event_type",
    "items[].closed_reason": "closed_reason"
  },
  "errors": [
    "unauthorized",
    "bad_request",
    "rate_limited"
  ],
