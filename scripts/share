#!/bin/sh
# Показать сайт другому человеку по ссылке, пока он работает на этом Mac (D-131).
# Сайт и сервер собираются и запускаются одной программой на порту 8088, туннель
# выдаёт публичную https-ссылку. Mac не засыпает, пока команда работает.
# Остановка: Ctrl+C. Данные — те же, что у `make dev` (база scibox на порту 5433).
#
# Туннель: tuna (tuna.am, российский сервис), если он установлен, иначе localhost.run
# (ничего ставить не нужно, работает через ssh). Выбрать вручную: SCIBOX_TUNNEL=tuna или
# SCIBOX_TUNNEL=localhost.run.
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
port=${SCIBOX_SHARE_PORT:-8088}
log=$(mktemp -t scibox-tunnel)

if lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
  echo "Порт $port занят: похоже, сайт уже показывается. Остановите прошлый запуск (Ctrl+C в его окне)." >&2
  exit 1
fi

tunnel=${SCIBOX_TUNNEL:-}
if [ -z "$tunnel" ]; then
  if command -v tuna >/dev/null 2>&1; then tunnel=tuna; else tunnel=localhost.run; fi
fi

pids=""
tunnel_pid=""
cleanup() {
  # shellcheck disable=SC2086
  [ -n "$pids$tunnel_pid" ] && kill $pids $tunnel_pid 2>/dev/null || true
  rm -f "$log"
}
trap cleanup EXIT
trap 'exit 130' INT TERM

echo "Собираю сайт…"
if ! (cd "$root/web" && npm run build >"$log" 2>&1); then
  cat "$log" >&2
  exit 1
fi
echo "Собираю сервер…"
(cd "$root/server" && go build -o bin/scibox ./cmd/api)

case "$tunnel" in
  tuna) pattern='https://[A-Za-z0-9.-]*tuna\.am' ;;
  localhost.run) pattern='https://[A-Za-z0-9.-]*\.(lhr\.life|localhost\.run)' ;;
  *)
    echo "Неизвестный туннель «$tunnel»: можно tuna или localhost.run." >&2
    exit 2
    ;;
esac

tunnel_pid=""
start_tunnel() {
  : >"$log"
  case "$tunnel" in
    tuna) tuna http "$port" >"$log" 2>&1 & ;;
    localhost.run)
      ssh -T -o StrictHostKeyChecking=accept-new -o ServerAliveInterval=30 -o ServerAliveCountMax=3 \
        -o ExitOnForwardFailure=yes -R 80:127.0.0.1:"$port" nokey@localhost.run >"$log" 2>&1 &
      ;;
  esac
  tunnel_pid=$!
}

# Последняя ссылка, которую выдал туннель: бесплатный localhost.run время от времени меняет адрес
# в том же соединении и пишет новый в свой вывод.
latest_url() {
  grep -aEo "$pattern" "$log" | grep -v 'admin\.localhost\.run' | tail -n 1 || true
}

wait_url() {
  i=0
  url=""
  while [ -z "$url" ] && [ $i -lt 60 ]; do
    sleep 1
    url=$(latest_url)
    i=$((i + 1))
  done
}

# Ссылку видно в окне и во всплывающем уведомлении: человеку не нужно следить за окном.
announce() {
  echo
  echo "  $1:  $url"
  echo
  osascript -e "display notification \"$url\" with title \"SciBox: $1\"" >/dev/null 2>&1 || true
}

echo "Открываю туннель ($tunnel)…"
start_tunnel
wait_url
if [ -z "$url" ]; then
  echo "Туннель не дал ссылку за минуту. Что он ответил:" >&2
  cat "$log" >&2
  exit 1
fi

# Ссылки в письмах и защита от чужих сайтов строятся от публичного адреса.
(cd "$root/server" && SCIBOX_HTTP_ADDR="127.0.0.1:$port" SCIBOX_WEB_DIR="$root/web/dist" \
  SCIBOX_PUBLIC_URL="$url" exec ./bin/scibox serve) &
pids="$pids $!"

i=0
until curl -fsS "http://127.0.0.1:$port/api/health" >/dev/null 2>&1; do
  i=$((i + 1))
  if [ $i -gt 30 ]; then
    echo "Сервер не запустился за 30 секунд." >&2
    exit 1
  fi
  sleep 1
done

# Не засыпать, пока работает показ (экран гаснуть может; с закрытой крышкой без зарядки Mac всё равно уснёт).
caffeinate -ims -w $$ &
pids="$pids $!"

echo "  Письма сайта:  http://localhost:8025 (коллеге они не придут, ссылку из письма можно переслать)"
echo "  Остановить:    Ctrl+C"
announce "Ссылка для коллеги"

# Следим за туннелем: новая ссылка — сообщить, обрыв — переподключить.
# Сервер не перезапускаем: защита от чужих сайтов принимает и адрес, по которому пришёл запрос;
# только ссылки в новых письмах будут со старым адресом.
while sleep 5; do
  if ! kill -0 "$tunnel_pid" 2>/dev/null; then
    echo "Туннель оборвался, подключаю заново…"
    sleep 3
    start_tunnel
    wait_url
    if [ -n "$url" ]; then
      announce "Новая ссылка для коллеги (старая больше не работает)"
    fi
    continue
  fi
  now=$(latest_url)
  if [ -n "$now" ] && [ "$now" != "$url" ]; then
    url=$now
    announce "Ссылка сменилась, отправьте коллеге новую"
  fi
done
