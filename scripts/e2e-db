#!/bin/sh
# Чистая база для сквозных тестов: отдельная scibox_e2e, демо-данные залиты заново.
# База для обычной работы (scibox) не трогается.
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"

docker compose exec -T -e PGOPTIONS="-c client_min_messages=warning" postgres psql -q -v ON_ERROR_STOP=1 -U scibox -d scibox \
  -c "DROP DATABASE IF EXISTS scibox_e2e WITH (FORCE)" \
  -c "CREATE DATABASE scibox_e2e"

(cd server && go build -o bin/scibox ./cmd/api)
export DATABASE_URL="postgres://scibox:scibox@localhost:5433/scibox_e2e?sslmode=disable"
(cd server && ./bin/scibox migrate up >/dev/null && ./bin/scibox journals load >/dev/null && ./bin/scibox seed)
