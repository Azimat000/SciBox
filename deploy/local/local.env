# Переменные репетиции боевого стенда на этом компьютере (срез 28). Для настоящего сервера используйте deploy/.env
# (deploy/env.example).
SCIBOX_DOMAIN=localhost
PUBLIC_PORT_SUFFIX=:8443
HTTP_PORT=8081
HTTPS_PORT=8443
CADDYFILE=Caddyfile.local
MAILPIT_PORT=8026
SMTP_ADDR=mail.scibox.test:1025
SMTP_TLS=starttls
MAIL_FROM=ИОН <no-reply@scibox.example.ru>
S3_ENDPOINT=s3.scibox.test:8443
S3_BUCKET=scibox-files-rehearsal
S3_PATH_STYLE=on
BACKUP_S3_ENDPOINT=s3.scibox.test:8443
BACKUP_S3_BUCKET=scibox-backup-rehearsal
BACKUP_S3_URI_STYLE=path
BACKUP_S3_CA_FILE=/pki-ca/ca.crt
EXTRA_CA_DIR=/pki-ca
# Память Docker на этом компьютере 3,8 ГБ на все проекты.
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=768MB
APP_MEMORY=512m
DB_MAX_CONNS=10
# Копии в репетиции делаются чаще, чтобы проверка восстановления не ждала сутки.
BACKUP_DIFF_EVERY_HOURS=1
BACKUP_FILES_EVERY_HOURS=1
# Тревоги репетиции уходят в Mailpit (http://localhost:8026). Мониторинг в репетиции включается вручную:
#   SCIBOX_DEPLOY_LOCAL=1 MONITORING=on deploy/deploy.sh --build   (нужно ещё около 1 ГБ памяти Docker)
ALERT_EMAIL_TO=admin@scibox.example.ru
