# Настройки боевого стенда ИОН (срез 28). Скопируйте в deploy/.env и заполните: cp env.example .env
# Секреты (пароли, ключи) здесь НЕ пишутся: они лежат отдельными файлами в deploy/secrets (./init-secrets.sh).
# Подробно: docs/DEPLOY.md.

# --- Сайт ---
# Доменное имя сайта; запись A (и AAAA) в DNS должна указывать на этот сервер до первого запуска, иначе Caddy не
# получит сертификат.
SCIBOX_DOMAIN=scibox.example.ru
# Почта, на которую центр сертификации присылает предупреждения о сроке сертификата.
ACME_EMAIL=admin@example.ru
# Версия образа сервера; deploy.sh подставляет её сам (--build или аргумент).
# SCIBOX_IMAGE=scibox:1.0.0

# --- Почта (SMTP почтового сервиса) ---
# Хост и порт: 587 с STARTTLS (SMTP_TLS=starttls) или 465 с TLS (SMTP_TLS=tls).
SMTP_ADDR=smtp.example.ru:587
SMTP_TLS=starttls
SMTP_USER=no-reply@scibox.example.ru
# Адрес отправителя: настоящий адрес на домене сайта (со стороны почтового сервиса настроены SPF, DKIM, DMARC).
MAIL_FROM=ИОН <no-reply@scibox.example.ru>

# --- Хранилище файлов откликов (S3-совместимое: Yandex Object Storage, Selectel, VK Cloud...) ---
# Бакет приватный, шифрование на стороне провайдера включено; ключи сервисного аккаунта лежат в secrets/s3_*.
S3_ENDPOINT=storage.yandexcloud.net
S3_BUCKET=scibox-files
S3_REGION=ru-central1
# on, если провайдер требует адреса вида хост/бакет/ключ; у облаков обычно off.
S3_PATH_STYLE=off

# --- Хранилище копий (ДРУГОЙ бакет, лучше у другого провайдера или в другом аккаунте) ---
# Ключи: secrets/backup_s3_*. Копии шифруются нами до отправки (secrets/backup_cipher_pass и backup_files_crypt_pass).
BACKUP_S3_ENDPOINT=storage.yandexcloud.net
BACKUP_S3_BUCKET=scibox-backup
BACKUP_S3_REGION=ru-central1
# host — адреса вида бакет.хост (облака), path — хост/бакет (собственные хранилища).
BACKUP_S3_URI_STYLE=host
# Срок хранения копий в днях (решение D-185: 30). Удалённый аккаунт остаётся в копиях не дольше этого срока.
BACKUP_RETENTION_DAYS=30
# Полная копия базы раз в столько дней, разностная раз в столько часов (журнал изменений уходит каждую минуту).
BACKUP_FULL_EVERY_DAYS=7
BACKUP_DIFF_EVERY_HOURS=24
# Копия файлов откликов раз в столько часов.
BACKUP_FILES_EVERY_HOURS=24

# --- Ресурсы (подберите под сервер; по умолчанию рассчитано на 4 ядра и 8 ГБ памяти) ---
# База: не меньше четверти памяти сервера под shared_buffers, effective_cache_size около половины.
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
# Соединений с базой на одну копию сервера (воркер берёт не больше 10).
DB_MAX_CONNS=20
APP_MEMORY=1g
# Для полного ClamAV нужно не меньше 2-3 ГБ.
CLAMAV_MEMORY=3g

# --- Необязательное ---
# Отчёты об ошибках (GlitchTip): https://ключ@хост/номер. Пусто — отчёты никуда не уходят.
SCIBOX_ERROR_DSN=
# Почта для «вежливого пула» Crossref (поиск публикаций по DOI).
CROSSREF_MAILTO=
LOG_LEVEL=info

# --- Тревоги (профиль monitoring) ---
# Кому присылать письма о неполадках (через ту же почтовую службу, SMTP_* выше).
ALERT_EMAIL_TO=admin@example.ru
