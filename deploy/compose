#!/bin/sh
# Обёртка над `docker compose` для боевого стенда (срез 28): подставляет файлы и окружение, чтобы все скрипты и
# команды из docs/DEPLOY.md вызывали compose одинаково.
#
#   ./compose ps                       боевой стенд (deploy/.env)
#   SCIBOX_DEPLOY_LOCAL=1 ./compose ps репетиция на этом компьютере (deploy/local/local.env, самоподписанный сертификат)
set -eu
here=$(cd "$(dirname "$0")" && pwd)
# Версия образа, выложенная последней (deploy.sh пишет её в .state): без неё compose взял бы образ по умолчанию и
# пересоздал бы контейнеры с чужой версией.
if [ -z "${SCIBOX_IMAGE:-}" ] && [ -s "$here/.state/current-image" ]; then
    SCIBOX_IMAGE=$(cat "$here/.state/current-image")
    export SCIBOX_IMAGE
fi
# Образ базы с отпечатком содержимого deploy/postgres: пересоздаётся только при настоящем изменении.
DB_IMAGE=${DB_IMAGE:-$("$here/db-image-tag")}
export DB_IMAGE
if [ "${SCIBOX_DEPLOY_LOCAL:-}" = 1 ]; then
    exec docker compose -f "$here/docker-compose.prod.yml" -f "$here/docker-compose.local.yml" \
        --env-file "$here/local/local.env" "$@"
fi
if [ ! -f "$here/.env" ]; then
    echo "нет файла deploy/.env: cp deploy/env.example deploy/.env и заполните (docs/DEPLOY.md)" >&2
    exit 1
fi
exec docker compose -f "$here/docker-compose.prod.yml" --env-file "$here/.env" "$@"
